# ===== 应用 =====
APP_NAME=Arch-Harness API
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
# SQLite（开发）
DB_URL=sqlite+aiosqlite:///./arch_harness.db
# PostgreSQL（生产）
# DB_URL=postgresql+asyncpg://arch:arch@localhost:5432/arch_harness
# 连接池（仅 PostgreSQL 生效）：避免压测时池等待被误读成慢查询
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ===== JWT =====
# 生产环境必须替换：openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRES=7200
JWT_REFRESH_EXPIRES=604800
JWT_REFRESH_EXPIRES_SHORT=86400

# ===== CORS（逗号分隔） =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 安全 =====
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# ===== AI 引擎 / 沙箱（prd-06 §6 / §12.7）=====
# mock = checksum 派生的确定性假数据（默认，联调/演示用）
# real = 真实解析（ezdxf / PyMuPDF）；线上出事直接改回 mock 重启即可回退，不需要改代码
REVIEW_ENGINE=mock
# 沙箱工具超时（秒）：DXF 大图单独放宽
SANDBOX_TOOL_TIMEOUT=60
SANDBOX_DXF_TIMEOUT=180
SANDBOX_PDF_TIMEOUT=120
# DXF 白名单图层（逗号分隔，全大写）
SANDBOX_DXF_LAYERS=WALL,DOOR,WINDOW,COLUMN
# 数值护栏：FIELD_ONLY（V1.0 只校验 fact_ref 存在性）/ FULL_SCAN（含正文数值比对）
FACT_REF_MODE=FIELD_ONLY
